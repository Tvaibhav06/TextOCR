{
  "name": "textremover-poc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "test": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:e2e": "detox test --configuration android.emu.debug",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.73.6",
    "expo": "~50.0.0",
    "expo-image-manipulator": "^11.8.0",
    "expo-image-picker": "^14.7.1",
    "expo-media-library": "^15.9.1",
    "expo-gl": "^13.6.0",
    "@shopify/react-native-skia": "^1.2.3",
    "react-native-vision-camera": "^4.3.2",
    "react-native-fast-tflite": "^1.1.0",
    "@infinitered/react-native-mlkit-object-detection": "^1.0.0",
    "react-native-fast-image": "^8.6.3",
    "react-native-mmkv": "^2.12.2",
    "@react-native-async-storage/async-storage": "^1.23.1",
    "react-native-reanimated": "~3.6.2",
    "react-native-gesture-handler": "~2.14.0",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/stack": "^6.3.29",
    "zustand": "^4.5.2",
    "axios": "^1.6.8"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "^18.2.6",
    "@types/react-native": "^0.73.0",
    "typescript": "^5.1.3",
    "jest": "^29.7.0",
    "@testing-library/react-native": "^12.4.3",
    "@testing-library/jest-native": "^5.4.3",
    "detox": "^20.18.1",
    "jest-circus": "^29.7.0",
    "babel-jest": "^29.7.0"
  },
  "jest": {
    "preset": "react-native",
    "setupFilesAfterEnv": ["@testing-library/jest-native/extend-expect"],
    "moduleFileExtensions": ["ts", "tsx", "js", "jsx"],
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|expo|@expo|@shopify/react-native-skia|react-native-fast-tflite)/)"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.{ts,tsx}",
      "<rootDir>/src/**/__tests__/**/*.{ts,tsx}"
    ],
    "collectCoverageFrom": ["src/**/*.{ts,tsx}", "!src/**/*.d.ts"]
  }
}
