<?xml version="1.0" encoding="utf-8"?>
<!--
  network_security_config.xml
  ───────────────────────────
  Phase 2: Allows cleartext HTTP traffic to the PC backend server.

  Permitted cleartext targets:
    10.0.2.2  — Android emulator loopback (maps to PC's localhost)
    10.0.3.2  — Genymotion emulator loopback
    192.168.0.0/16 — Common LAN range (Wi-Fi, for physical devices)
    172.16.0.0/12  — Corporate LAN range
    localhost / 127.0.0.1 — For local dev
-->
<network-security-config>
    <!-- Allow cleartext for the backend in debug/dev builds -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Android emulator → PC localhost -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- Genymotion emulator → PC localhost -->
        <domain includeSubdomains="false">10.0.3.2</domain>
        <!-- Physical device on LAN (192.168.x.x) -->
        <domain includeSubdomains="false">192.168.0.0</domain>
        <!-- localhost -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
